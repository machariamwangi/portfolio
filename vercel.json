{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm install",
  "buildCommand": "env -u npm_config_cache_dir -u NPM_CONFIG_CACHE_DIR npm run build",
  "functions": {
    "api/cms-auth.js": { "installCommand": "" }
  },
  "redirects": [
    {
      "source": "/admin/:path*",
      "missing": [{ "type": "host", "value": "elijahmwangi.net" }],
      "destination": "https://elijahmwangi.net/admin/:path*",
      "permanent": false
    }
  ]
}
